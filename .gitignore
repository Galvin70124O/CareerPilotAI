# Python cache files
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv
env/

# Trained model files. model.pkl IS committed, so Render can serve it without training.
# After retraining (python train.py), commit the new model.pkl.
*.pkl
!model.pkl
*.joblib

# Prepared dataset (~20 MB). Rebuilt by: python data/prepare_data.py
# (train.py also does this automatically when the file is missing)
data/resumes.parquet

# Secrets / local settings
.env

# Local tool output (Impeccable design config, Graphify knowledge graph)
.impeccable/
graphify-out/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Raw O*NET / ESCO downloads. Rebuilt by: python data/fetch_sources.py
data/raw/

# local progress log for resuming sessions
docs/progress.md

# playwright-cli downloads and snapshots
.playwright-cli/
